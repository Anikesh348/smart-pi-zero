[Unit]
Description=Pi Zero TV Launcher Flask App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/smart-pi-zero
Environment=PATH=/home/pi/smart-pi-zero/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
ExecStart=/home/pi/smart-pi-zero/.venv/bin/python /home/pi/smart-pi-zero/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
